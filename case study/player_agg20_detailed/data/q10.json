  "query_id": "q10",
  "natural_language_query": "Among players with at least one FIBA World Cup title, what is the total number of FIBA titles for each current NBA team?",
  "reference_sql": "SELECT p.team, SUM(p.fiba_world_cup) AS total_fiba_titles FROM player p JOIN team t ON p.team = t.team_name WHERE p.fiba_world_cup >= 1 GROUP BY p.team",
