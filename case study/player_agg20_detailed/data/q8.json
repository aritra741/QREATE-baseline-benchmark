  "natural_language_query": "Among players with a known position and at least one Olympic gold medal, what is the average number of Olympic golds at each position?",
  "reference_sql": "SELECT position, AVG(olympic_gold_medals) AS avg_olympic_golds FROM player WHERE olympic_gold_medals >= 1 AND position IN ('Frontcourt', 'Backcourt') GROUP BY position",
