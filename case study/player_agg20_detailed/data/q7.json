  "query_id": "q7",
  "natural_language_query": "For each current NBA team, what is the earliest (lowest) draft pick among its drafted players?",
  "reference_sql": "SELECT p.team, MIN(p.draft_pick) AS earliest_draft_pick FROM player p JOIN team t ON p.team = t.team_name WHERE p.draft_pick > 0 GROUP BY p.team",
