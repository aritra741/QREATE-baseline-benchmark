 player GROUP BY position", "attr:Expanded/agg_join_expanded.sql#5:15c06c11": "/* Query 5: agg_join (city, player, team) */ SELECT player.position, COUNT(player.draft_year) AS count_player_mvp_awards FROM player JOIN team ON player.team = team.team_name JOIN city ON team.location = city.city_name GROUP BY player.position", "attr:Variations/Agg/agg_variations.sql#1:84662181": "/* Inspiration: Query 1 (agg_queries.sql) */ /* Variation: Changed MIN to MAX for olympic_gold_medals grouped by position. */ SELECT position, MAX(fiba_world_cup) AS max_olympic_gold_medals FROM player GROUP BY position", "attr:docetl_Player_v7:q0:a5bdcfba": "SELECT position, AVG(draft_year) AS avg_age FROM player WHERE position IN ('Frontcourt', 'Backcourt') GROUP BY position", "attr:Splits/train.sql#74:2968ff54": "/* Query 74: train (agg_filter_join) id=agg_filter_join_gen_184 */ SELECT player.nationality, MIN(player.draft_year) AS min_player_olympic_gold_medals FROM player JOIN team ON player.team = team.team_name JOIN city ON team.location = city.city_name WHERE player.age < 35 GROUP BY player.nationality", "attr:Splits/dev.sql#11:8b66cd72": "/* Query 11: dev (agg_join) id=agg_join_expanded_7 */ SELECT player.position, COUNT(player.nba_championships) AS count_player_mvp_awards FROM player JOIN team ON player.team = team.team_name GROUP BY player.position", "attr:Splits/dev.sql#18:013eb2e8": "/* Query 18: dev (agg_filter_join) id=agg_filter_join_gen_12 */ SELECT player.nationality, AVG(player.fiba_world_cup) AS avg_player_age FROM player JOIN team ON player.team = team.team_name WHERE (player.nationality = 'French') OR (player.team = 'Lokomotiv Kuban') GROUP BY player.nationality", "attr:Expanded/agg_only_expanded.sql#14:c60f4651": "/* Query 14: agg_only (player, team) */ SELECT team, MIN(draft_year) AS min_mvp_awards FROM player GROUP BY team", "attr:player_multiagg20:q12:a5be78a3": "SELECT t.team_name, COUNT(*) AS player_count, AVG(p.draft_year) AS avg_age, SUM(CASE WHEN p.mvp_awards >= 1 THEN 1 ELSE 0 END) AS mvp_winner_count, MAX(t.championship) AS team_titles FROM player AS p JOIN team AS t ON TRIM(p.team) = TRIM(t.team_name) GROUP BY t.team_name HAVING COUNT(*) >= 2", "attr:Splits/test.sql#3:4e167992": "/* Query 3: test (agg_only) id=agg_only_gen_94 */ SELECT nationality, college, SUM(olympic_gold_medals) AS sum_olympic_gold_medals FROM player GROUP BY nationality, college", "attr:Splits/train.sql#37:38657b49": "/* Query 37: train (agg_filter) id=agg_filter_gen_119 */ SELECT position, SUM(draft_year) AS sum_olympic_gold_medals FROM player WHERE (nationality = 'American-born naturalized Azerbaijani') OR (nationality <> 'Greek-American') GROUP BY position", "attr:player_multiagg20:q4:e223d11d": "SELECT t.team_name, COUNT(*) AS player_count, AVG(p.draft_pick) AS avg_age, SUM(CASE WHEN NOT p.olympic_gold_medals IS NULL THEN p.olympic_gold_medals ELSE 0 END) AS total_recorded_olympic_golds FROM player AS p JOIN team AS t ON TRIM(p.team) = TRIM(t.team_name) GROUP BY t.team_name HAVING COUNT(*) >= 2", "attr:Splits/test.sql#14:07834953": "/* Query 14: test (agg_join) id=agg_join_gen_4 */ SELECT player.position, MAX(player.draft_pick) AS max_player_mvp_awards FROM player JOIN team ON player.team = team.team_name GROUP BY player.position", "attr:Expanded/agg_filter_expanded.sql#14:c7e1850b": "/* Query 14: agg_filter (player) */ SELECT nationality, SUM(draft_year) AS sum_olympic_gold_medals FROM player WHERE (nationality = 'Serbian') OR (nationality <> 'Nigerian-American') GROUP BY nationality"}, "records": [{"pos": 0, "qid": "attr:docetl_Player_v7:q4:dd9b4ab5", "drift": true, "action": "patch", "missing": {"player": ["nba_championships"]}, "scope_docs": 138, "docs_read": 138, "fetched": {"player.nba_championships": 138}, "runtime_s": 43.89, "calls": 191, "input_tokens": 925440, "output_tokens": 6965, "cost_usd": 0.093937, "paid": {"input": 925440, "output": 6965, "cost": 0.093937, "calls": 191}, "view": "/sessions/rcw-01n4cex6u5bon8kzynq4paep/quwarts_scrat