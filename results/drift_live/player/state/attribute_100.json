{"pos": 28, "seen": {"attr:docetl_Player_v7:q4:dd9b4ab5": "SELECT position, SUM(nba_championships) AS total_mvp_awards FROM player WHERE position IN ('Frontcourt', 'Backcourt') GROUP BY position", "attr:Expanded/agg_filter_expanded.sql#1:c5608ae2": "/* Query 1: agg_filter (player) */ SELECT nationality, AVG(draft_pick) AS avg_age FROM player WHERE nationality = 'Serbian' GROUP BY nationality", "attr:Expanded/agg_only_expanded.sql#10:a23eaa3e": "/* Query 10: agg_only (player) */ SELECT nationality, SUM(fiba_world_cup) AS sum_olympic_gold_medals FROM player GROUP BY nationality", "attr:Expanded/agg_filter_join_expanded.sql#5:e4adf27a": "/* Query 5: agg_filter_join (player, team) */ SELECT team.ownership, COUNT(*) AS count_all FROM player JOIN team ON player.team = team.team_name WHERE team.ownership = 'Glen Taylor' GROUP BY team.ownership", "attr:Expanded/agg_join_expanded.sql#1:ed9dfa67": "/* Query 1: agg_join (city, player, team) */ SELECT player.position, MAX(player.draft_pick) AS max_player_mvp_awards FROM player JOIN team ON player.team = team.team_name JOIN city ON team.location = city.city_name GROUP BY player.position", "attr:Splits/train.sql#39:cfc6a04a": "/* Query 39: train (agg_filter) id=agg_filter_gen_200 */ SELECT team, SUM(fiba_world_cup) AS sum_olympic_gold_medals FROM player WHERE (nationality <> 'Nigerian-American' AND team = 'Lokomotiv Kuban') OR (team = 'Saski Baskonia') GROUP BY team", "attr:Splits/train.sql#36:267aed6c": "/* Query 36: train (agg_filter) id=agg_filter_gen_115 */ SELECT position, SUM(nba_championships) AS sum_olympic_gold_medals FROM player WHERE (nationality <> 'French') OR (nationality = 'Greek-American') GROUP BY position", "attr:Splits/train.sql#47:c40d7c13": "/* Query 47: train (agg_join) id=agg_join_gen_21 */ SELECT player.position, MIN(player.draft_pick) AS min_player_olympic_gold_medals FROM player JOIN team ON player.team = team.team_name JOIN city ON team.location = city.city_name GROUP BY player.position", "attr:Splits/t