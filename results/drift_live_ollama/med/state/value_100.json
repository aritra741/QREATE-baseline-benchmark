{"pos": 14, "seen": {"value:Splits/test.sql#7:67383eff": "/* Query 7: test (agg_filter) id=agg_filter_med_gen_65 */ SELECT prescription_status, COUNT(side_effects) AS count_side_effects FROM drug WHERE administration_route = 'intravenous' GROUP BY prescription_status", "value:Splits/train.sql#36:8e8ce711": "/* Query 36: train (agg_filter) id=agg_filter_med_gen_61 */ SELECT prescription_status, COUNT(side_effects) AS count_side_effects FROM drug WHERE administration_route <> 'other' GROUP BY prescription_status", "value:Splits/test.sql#6:b385bed5": "/* Query 6: test (agg_filter) id=agg_filter_med_gen_77 */ SELECT prescription_status, COUNT(side_effects) AS count_side_effects FROM drug WHERE pharmaceutical_form <> 'powder' GROUP BY prescription_status", "value:med_agg20:q11:158a71d3": "SELECT CASE WHEN LOWER(pathogenesis) LIKE '%infectious%' THEN 'infectious' WHEN LOWER(pathogenesis) LIKE '%vascular%' THEN 'vascular' WHEN pathogenesis <> '' THEN 'other' END AS path_group, COUNT(*) AS disease_count FROM disease WHERE pathogenesis <> '' GROUP BY path_group", "value:Splits/train.sql#62:3f339a28": "/* Query 62: train (agg_filter_join) id=agg_filter_join_med_gen_112 */ SELECT drug.administration_route, MAX(drug.dosage_frequency) AS max_drug_dosage_frequency FROM drug JOIN disease ON drug.disease_name = disease.disease_name WHERE disease.pathogenesis <> 'allergic||toxic' GROUP BY drug.administration_route", "value:Splits/train.sql#78:47d8a3bb": "/* Query 78: train (agg_filter_join) id=agg_filter_join_med_gen_42 */ SELECT drug.prescription_status, MIN(drug.dosage_frequency) AS min_drug_dosage_frequency FROM drug JOIN disease ON drug.disease_name = disease.disease_name WHERE (drug.pharmaceutical_form = 'powder') OR (disease.pathogenesis <> 'autoimmune||allergic') GROUP BY drug.prescription_status", "value:med_agg20:q4:f205b5a7": "SELECT CASE WHEN LOWER(dr.pharmaceutical_form) LIKE '%solution%' THEN 'solution' WHEN LOWER(dr.pharmaceutical_form) LIKE '%injection%' THEN 'injection' WHEN LOWER(dr.pharmaceutical_form) LIKE '%capsule%' THEN 'capsule' WHEN dr.pharmaceutical_form <> '' THEN 'other' END AS form_family, COUNT(*) AS drug_count FROM drug AS dr WHERE dr.pharmaceutical_form <> '' GROUP BY form_family", "value:med_filterjoin20:q0:61edee37": "SELECT CASE WHEN LOWER(d.disease_type) LIKE '%vascular%' THEN 'vascular' WHEN LOWER(d.disease_type) LIKE '%neoplastic%' THEN 'neoplastic' WHEN LOWER(d.disease_type) LIKE '%inflammatory%' THEN 'inflammatory' WHEN LOWER(d.disease_type) LIKE '%psychiatric%' THEN 'psychiatric' WHEN d.disease_type <> '' THEN 'other' END AS type_family, COUNT(*) AS disease_count FROM disease AS d WHERE LOWER(d.treatments) LIKE '%oral_medication%' AND d.disease_type <> '' GROUP BY type_family", "value:Splits/train.sql#27:f1f26d40": "/* Query 27: train (agg_filter) id=agg_filter_med_gen_83 */ SELECT prescription_status, MIN(dosage_frequency) AS min_dosage_frequency FROM drug WHERE (pharmaceutical_form = 'powder') OR (pharmaceutical_form <> 'tablet||solution') GROUP BY prescription_status", "value:Splits/train.sql#80:758cf6ec": "/* Query 80: train (agg_filter_join) id=mixed_queries_filter_agg_join_11 */ SELECT drug.prescription_status, SUM(disease.treatment_challenges) AS sum_disease_treatment_challenges FROM disease JOIN drug ON disease.disease_name = drug.disease_name WHERE disease.treatments <> 'oral_medication||injection||surgery||dietary_intervention||others' OR drug.brand_name <> 'Valium' OR drug.brand_name = 'Omlek-D' GROUP BY drug.prescription_status", "value:Splits/train.sql#33:52b110b0": "/* Query 33: train (agg_filter) id=agg_filter_med_gen_28 */ SELECT prescription_status, COUNT(generic_name) AS count_generic_name FROM drug WHERE (administration_route = 'oral||intravenous||topical' AND administration_route <> 'intravenous') OR (pharmaceutical_form <> 'powder') GROUP BY prescription_status", "value:Splits/dev.sql#9:daf0e590": "/* Query 9: dev (agg_filter) id=agg_filter_med_gen_26 */ SELECT prescription_status, COUNT(generic_name) AS count_generic_name FROM drug WHERE (administration_route = 'oral||intravenous') AND (administration_route <> 'other') GROUP BY prescription_status", "value:Splits/test.sql#9:42045a68": "/* Query 9: test (agg_filter) id=agg_filter_med_gen_120 */ SELECT administration_route, COUNT(*) AS count_all FROM drug WHERE (pharmaceutical_form <> 'capsule||tablet||injection' AND prescription_status = 'prescription_only||restricted') OR (pharmaceutical_form = 'powder') GROUP BY administration_route", "value:Splits/train.sql#28:11df9726": "/* Query 28: train (agg_filter) id=agg_filter_med_gen_76 */ SELECT prescription_status, COUNT(side_effects) AS count_side_effects FROM drug WHERE (pharmaceutical_form = 'powder' AND pharmaceutical_form <> 'capsule||tablet||suspension||injection||powder||ointment') OR (pharmaceutical_form <> 'capsule||other') GROUP BY prescription_status"}, "records": [{"pos": 0, "qid": "value:Splits/test.sql#7:67383eff", "drift": true, "anticipated": false, "action": "answer", "missing": {}, "scope_docs": 0, "docs_read": 0, "fetched": {}, "runtime_s": 0.64, "calls": 0, "input_tokens": 0, "output_tokens": 0, "cost_usd": 0.0, "paid": {"input": 0, "output": 0, "cost": 0.0, "calls": 0}, "maybe_truncated_calls": 0, "cut_off_calls": 0, "view": "/uufs/chpc.utah.edu/common/home/u1592362/quwarts_scratch/drift_live_ollama/med/value_100/views/000.db", "digest": "8568bfc40eb01854"}, {"pos": 1, "qid": "value:Splits/train.sql#36:8e8ce711", "drift": true, "anticipated": false, "action": "answer", "missing": {}, "scope_docs": 0, "docs_read": 0, "fetched": {}, "runtime_s": 0.68, "calls": 0, "input_tokens": 0, "output_tokens": 0, "cost_usd": 0.0, "paid": {"input": 0, "output": 0, "cost": 0.0, "calls": 0}, "maybe_truncated_calls": 0, "cut_off_calls": 0, "view": "/uufs/chpc.utah.edu/common/home/u1592362/quwarts_scratch/drift_live_ollama/med/value_100/views/001.db", "digest": "8568bfc40eb01854"}, {"pos": 2, "qid": "value:Splits/test.sql#6:b385bed5", "drift": tr