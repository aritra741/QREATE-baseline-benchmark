{"pos": 11, "seen": {"attr:Splits/test.sql#9:89669ef3": "/* Query 9: test (agg_filter) id=agg_filter_med_gen_120 */ SELECT administration_route, COUNT(*) AS count_all FROM drug WHERE (manufacturer <> 'Galderma Laboratories, L.P.' AND prescription_status = 'unclassified') OR (manufacturer = 'Bayer') GROUP BY administration_route", "attr:Splits/train.sql#6:f6d3251f": "/* Query 6: train (agg_only) id=agg_only_med_gen_14 */ SELECT administration_route, MAX(recommended_usage) AS max_dosage_frequency FROM drug GROUP BY administration_route", "attr:Splits/dev.sql#14:dba14859": "/* Query 14: dev (agg_join) id=agg_join_med_gen_5 */ SELECT drug.prescription_status, MAX(drug.single_dose) AS max_drug_dosage_frequency FROM drug JOIN disease ON drug.disease_name = disease.disease_name GROUP BY drug.prescription_status", "attr:Splits/train.sql#53:b59f3915": "/* Query 53: train (agg_join) id=agg_join_med_gen_26 */ SELECT disease.disease_type, MAX(drug.storage_conditions) AS max_drug_dosage_frequency FROM drug JOIN disease ON drug.disease_name = disease.disease_name GROUP BY disease.disease_type", "attr:Splits/test.sql#12:efd2b36a": "/* Query 12: test (agg_join) id=agg_join_med_gen_12 */ SELECT drug.manufacturer, MAX(drug.dosage_frequency) AS max_drug_dosage_frequency FROM drug JOIN disease ON drug.disease_name = disease.disease_name GROUP BY drug.manufacturer", "attr:Splits/train.sql#57:18795eef": "/* Query 57: train (agg_join) id=agg_join_med_gen_28 */ SELECT disease.complications, COUNT(disease.treatments) AS count_disease_treatments FROM drug JOIN disease ON drug.disease_name = disease.disease_name GROUP BY disease.complications", "attr:Splits/test.sql#9:5bc7e3e4": "/* Query 9: test (agg_filter) id=agg_filter_med_gen_120 */ SELECT administration_route, COUNT(*) AS count_all FROM drug WHERE (storage_conditions <> 'store at room temperature||avoid freezing||store below 25C or 77F' AND prescription_status = 'unclassified') OR (storage_conditions = 'store at room temperature') GROUP